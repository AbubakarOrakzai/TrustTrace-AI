# Copy to .env only if you need to change local defaults.
TRUSTTRACE_DB_PATH=backend/trusttrace.db
TRUSTTRACE_KEY_PATH=backend/.trusttrace-signing-key.pem
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional model judge. "nebius" tries Nemotron first and falls back to
# Gemini when GEMINI_API_KEY is set. Use "none" for offline-only operation.
TRUSTTRACE_JUDGE_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Put your real key in an ignored local .env file; never commit it.
