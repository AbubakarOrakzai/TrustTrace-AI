# Copy to .env only if you need to change local defaults.
TRUSTTRACE_CORS_ORIGINS=http://localhost:3000
TRUSTTRACE_DB_PATH=backend/trusttrace.db
TRUSTTRACE_KEY_PATH=backend/.trusttrace-signing-key.pem
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Gemini judge. Leave provider as "none" for offline-only operation.
TRUSTTRACE_JUDGE_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Put your real key in an ignored local .env file; never commit it.
